#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Release checks require a clean working tree." >&2
  exit 1
fi

bundle check
bundle exec rake test
bundle exec rake build

version="$(bundle exec ruby -Ilib -r marsdate/version -e 'print MarsDateTime::VERSION')"
gem_file="pkg/marsdate-${version}.gem"

if [[ ! -f "$gem_file" ]]; then
  echo "Expected build artifact $gem_file was not created." >&2
  exit 1
fi

install_dir="$(mktemp -d)"
trap 'rm -rf "$install_dir"' EXIT

gem install --local --install-dir "$install_dir/gems" \
  --bindir "$install_dir/bin" --no-document "$gem_file"

actual_version="$(
  GEM_HOME="$install_dir/gems" GEM_PATH="$install_dir/gems" \
    "$install_dir/bin/marsdate" version
)"

if [[ "$actual_version" != "$version" ]]; then
  echo "Installed CLI reported $actual_version; expected $version." >&2
  exit 1
fi

echo
echo "Release checks passed for $gem_file."
echo "Review the package, then publish this exact file:"
echo "  gem push $gem_file"

